# ============================================================
# SoraPay — Environment Variables
# ============================================================
# Salin file ini jadi ".env.local" untuk testing lokal,
# atau isi langsung di Vercel Dashboard > Project > Settings > Environment Variables.
#
# Cara dapetin value Firebase: buka console.firebase.google.com
# > Project Settings (ikon gerigi) > scroll ke "Your apps" > Web app > SDK config.
# ============================================================

# --- Firebase (WAJIB, dipakai fitur VIP: login, admin panel, database) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ============================================================
# Catatan soal API downloader (TikTok, Instagram, Pinterest):
# API-API ini SENGAJA TIDAK dimasukkan ke sini karena semuanya
# publik & tanpa API key (tikwm.com, fastdl.app/f-d.app, savepin.app,
# widgets.pinterest.com) — tidak ada rahasia yang perlu disembunyikan,
# jadi endpoint-nya langsung ditulis di dalam index.html.
# ============================================================
