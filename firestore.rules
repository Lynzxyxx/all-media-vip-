rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/adminConfig/main) &&
        get(/databases/$(database)/documents/adminConfig/main).data.adminUid == request.auth.uid;
    }

    // Dokumen penanda siapa admin pertama. Cuma bisa dibuat sekali (saat belum ada admin).
    match /adminConfig/main {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/adminConfig/main);
      allow update, delete: if false;
    }

    // Profil user (role: admin/customer). User cuma boleh baca/tulis datanya sendiri;
    // admin boleh baca semua (untuk keperluan manajemen).
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Fitur VIP. Semua user yang sudah login boleh baca (lihat & buka fitur).
    // Cuma admin yang boleh tambah/edit/hapus.
    match /vipFeatures/{featureId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
